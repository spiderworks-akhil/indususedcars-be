{
  "kind": "collectionType",
  "collectionName": "dealer_locations",
  "info": {
    "singularName": "dealer-location",
    "pluralName": "dealer-locations",
    "displayName": "Dealer Location",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Place": {
      "type": "string"
    },
    "Page_Heading": {
      "type": "string"
    },
    "Description": {
      "type": "customField",
      "options": {
        "preset": "defaultHtml"
      },
      "customField": "plugin::ckeditor5.CKEditor"
    },
    "SEO": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "Slug": {
      "type": "uid",
      "targetField": "Place"
    },
    "Image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "Dealer_Lists": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::dealer-list.dealer-list",
      "mappedBy": "Dealer_Location"
    },
    "FAQ": {
      "type": "component",
      "repeatable": false,
      "component": "common.faq"
    }
  }
}
